{
  "name": "dsh-amd-model-load",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "在 DeepSeek Harness 里给 AMD Radeon TokenFactory 的免费模型显示实时负载徽章：设置页按五类分组 + 模型选择列表逐行显示状态点与百分比。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "amd",
    "radeon",
    "tokenfactory",
    "model-load"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ORIOW/dsh-amd-model-load.git"
  },
  "homepage": "https://github.com/ORIOW/dsh-amd-model-load#readme",
  "bugs": {
    "url": "https://github.com/ORIOW/dsh-amd-model-load/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "*",
    "react": "^18.2.0"
  }
}
